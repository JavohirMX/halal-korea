# ============================================================================
# DJANGO CORE SETTINGS
# ============================================================================

DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# CSRF Protection (space-separated list of trusted origins)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com https://www.yourdomain.com

# Site Configuration
SITE_URL=http://localhost:8000

# Environment identifier (development, staging, production)
ENVIRONMENT=development

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Option 1: Individual settings (recommended)
DB_NAME=halal_korea
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Option 2: Database URL (alternative)
# DATABASE_URL=postgis://user:password@localhost:5432/halal_korea

# Redis Cache (optional)
# REDIS_URL=redis://127.0.0.1:6379/1

# ============================================================================
# API KEYS
# ============================================================================

# Google Maps (required for maps functionality)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_ID=DEMO_MAP_ID

# Prayer Times API
PRAYER_TIMES_API_BASE_URL=https://api.aladhan.com

# ============================================================================
# OAUTH CONFIGURATION
# ============================================================================

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Halal Korea<noreply@yourdomain.com>

# Email Verification
EMAIL_VERIFICATION_TIMEOUT=86400

# ============================================================================
# TELEGRAM NOTIFICATIONS
# ============================================================================

TELEGRAM_NOTIFICATIONS_ENABLED=False
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ============================================================================
# SENTRY ERROR TRACKING
# ============================================================================

SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================

MONITORING_ENABLED=True
MONITORING_SAMPLE_RATE=0.1
MONITORING_SLOW_THRESHOLD_MS=1000
MONITORING_RETENTION_DAYS=7

# Health Check Thresholds (can also be configured via AlertRules in admin)
MONITORING_HEALTH_MIN_REQUESTS=10
MONITORING_HEALTH_ERROR_RATE_WARNING=5.0
MONITORING_HEALTH_ERROR_RATE_CRITICAL=10.0
MONITORING_HEALTH_RESPONSE_TIME_WARNING=2000
MONITORING_HEALTH_SECURITY_EVENTS_WARNING=5

# Google Analytics Integration (optional)
GA_PROPERTY_ID=
GA_CREDENTIALS_FILE=

# ============================================================================
# ALERT CONFIGURATION
# ============================================================================

ALERT_TELEGRAM_ENABLED=True
ALERT_EMAIL_ENABLED=True
ALERT_EMAIL_RECIPIENTS=admin@yourdomain.com,alerts@yourdomain.com

# ============================================================================
# WATERMARK CONFIGURATION
# ============================================================================

WATERMARK_ENABLED=True
WATERMARK_OPACITY=0.25
WATERMARK_ANGLE=-45
WATERMARK_SPACING=50
WATERMARK_SIZE=200
WATERMARK_TEXT=Halal Korea
WATERMARK_TEXT_SIZE=32

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300
REGISTRATION_RATE_LIMIT=3
REGISTRATION_RATE_WINDOW=3600
EMAIL_RATE_LIMIT=3
EMAIL_RATE_WINDOW=3600
CONTACT_RATE_LIMIT_5MIN=2
CONTACT_RATE_LIMIT_HOURLY=5
FEEDBACK_RATE_LIMIT_10MIN=2
FEEDBACK_RATE_LIMIT_DAILY=10
SOCIAL_AUTH_GOOGLE_PER_IP_LIMIT=10
SOCIAL_AUTH_GOOGLE_PER_IP_WINDOW=60
SOCIAL_AUTH_GITHUB_PER_IP_LIMIT=10
SOCIAL_AUTH_GITHUB_PER_IP_WINDOW=60

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log sampling rates (0.0 to 1.0)
# Lower values = less logging volume, useful for high-traffic endpoints
LOG_SAMPLE_RATE_PLACES=0.1
LOG_SAMPLE_RATE_LOCATION=0.01
LOG_SAMPLE_RATE_PRAYER=0.1

# Note: Security events and errors are ALWAYS logged at 100%
# Sampling only affects INFO/DEBUG level logs
